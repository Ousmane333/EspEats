<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <defs>
    <filter id="drop-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#9a3412" flood-opacity="0.25"/>
    </filter>
  </defs>
  <!-- Outer Orange Brand Background -->
  <rect width="100" height="100" rx="22" fill="#ea580c"/>
  <!-- White Outer Squircle -->
  <rect x="12" y="12" width="76" height="76" rx="22" fill="#ffffff" filter="url(#drop-shadow)"/>
  <!-- Inner Orange Squircle -->
  <rect x="22" y="22" width="56" height="56" rx="15" fill="#f97316"/>
  <!-- Centered Bold Italic Letter 'E' -->
  <text x="51" y="52" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" font-weight="900" font-style="italic" font-size="36" fill="#ffffff" text-anchor="middle" dominant-baseline="central">E</text>
</svg>
